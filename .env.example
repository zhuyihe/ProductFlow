# Atelier production-style self-hosted example.
# Copy to .env and replace every placeholder before exposing the app.

# Auth (env-only; never commit real values)
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
SETTINGS_ACCESS_TOKEN=replace-with-a-separate-settings-token
SESSION_SECRET=replace-with-another-long-random-session-secret

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=29280
WEB_PORT=29281
APP_HOST_PORT=29280
BACKEND_CORS_ORIGINS=https://image.example.com,http://localhost:29281,http://127.0.0.1:29281
SESSION_COOKIE_SECURE=true

# Published images for docker-compose.prod.yml.
ATELIER_BACKEND_IMAGE=ghcr.io/zhuyihe/atelier-backend:new-api-sso
ATELIER_WEB_IMAGE=ghcr.io/zhuyihe/atelier-web:new-api-sso

# Persistence (env-only)
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://atelier:replace-with-a-random-postgres-password@atelier-postgres:5432/atelier
REDIS_HOST_PORT=16379
REDIS_URL=redis://atelier-redis:6379/0

# Container runtime storage root stays fixed at /app/storage. For production reuse/migration from the
# old systemd release, bind-mount the existing host directory by setting STORAGE_HOST_PATH, for example:
# STORAGE_HOST_PATH=/home/cot/Atelier-release/shared/storage
# Leave STORAGE_HOST_PATH unset to use the default Docker named volume atelier-storage.
STORAGE_ROOT=/app/storage
# STORAGE_HOST_PATH=

# New API SSO and relay. NEW_API_SSO_SHARED_SECRET must match New API's PRODUCTFLOW_SSO_SECRET.
NEW_API_BASE_URL=https://api.example.com
NEW_API_RELAY_BASE_URL=https://api.example.com/v1
NEW_API_SSO_START_URL=https://api.example.com/api/productflow/sso/start
NEW_API_SSO_VERIFY_URL=
NEW_API_SSO_VERIFY_PATH=/api/productflow/sso/verify
NEW_API_SSO_SHARED_SECRET=replace-with-the-same-secret-used-by-new-api
NEW_API_SSO_TIMEOUT_SECONDS=10

# Provider settings are configured in the web settings page after startup.
# For New API SSO deployment, bootstrap OpenAI-compatible bindings without a shared API key.
# Ordinary users call providers with their own New API Atelier token.
TEXT_PROVIDER_KIND=openai
TEXT_API_KEY=
TEXT_BASE_URL=https://api.example.com/v1
TEXT_BRIEF_MODEL=gpt-4o
TEXT_COPY_MODEL=gpt-4o
IMAGE_PROVIDER_KIND=openai_images
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.example.com/v1
IMAGE_GENERATE_MODEL=gpt-image-1
IMAGE_RESPONSES_BACKGROUND_ENABLED=true
IMAGE_IMAGES_QUALITY=
IMAGE_IMAGES_STYLE=
IMAGE_MAIN_IMAGE_SIZE=1024x1024
IMAGE_PROMO_POSTER_SIZE=1024x1536

# Poster generation: template does not call the image provider; generated does.
POSTER_GENERATION_MODE=generated

# Poster rendering
POSTER_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Upload safety
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# Jobs
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=10000
GENERATION_MAX_CONCURRENT_TASKS=3
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900
